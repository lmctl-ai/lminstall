    {
      "id": "muse",
      "binary": "muse",
      "source": "https://dev.meta.ai/lp/muse-code",
      "recipes": {
        "linux": {
          "channel": "steps",
          "bin": "bin/muse",
          "bin_dir": "bin",
          "env": {
            "MUSE_INSTALL_DIR": "{dir}/bin",
            "MUSE_NO_MODIFY_PATH": "1",
            "MUSE_LOGIN": "0",
            "HOME": "{dir}/home",
            "MUSE_NO_AUTO_UPDATE": "1"
          },
          "steps": [
            {
              "url": "https://dev.meta.ai/install.sh",
              "file": "install.sh"
            },
            {
              "args": [
                "bash",
                "{dir}/install.sh"
              ]
            }
          ]
        },
        "darwin": {
          "channel": "steps",
          "bin": "bin/muse",
          "bin_dir": "bin",
          "env": {
            "MUSE_INSTALL_DIR": "{dir}/bin",
            "MUSE_NO_MODIFY_PATH": "1",
            "MUSE_LOGIN": "0",
            "HOME": "{dir}/home",
            "MUSE_NO_AUTO_UPDATE": "1"
          },
          "steps": [
            {
              "url": "https://dev.meta.ai/install.sh",
              "file": "install.sh"
            },
            {
              "args": [
                "bash",
                "{dir}/install.sh"
              ]
            }
          ]
        },
        "windows": {
          "channel": "steps",
          "bin": "bin/muse.cmd",
          "bin_dir": "bin",
          "env": {
            "MUSE_INSTALL_DIR": "{dir}/bin",
            "MUSE_NO_MODIFY_PATH": "1",
            "MUSE_LOGIN": "0",
            "HOME": "{dir}/home",
            "USERPROFILE": "{dir}/home",
            "MUSE_NO_AUTO_UPDATE": "1"
          },
          "steps": [
            {
              "url": "https://dev.meta.ai/install.ps1",
              "file": "install.ps1"
            },
            {
              "args": [
                "powershell.exe",
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "{dir}/install.ps1"
              ]
            }
          ]
        }
      }
