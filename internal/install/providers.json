    {
      "id": "hermes",
      "binary": "hermes",
      "source": "https://github.com/NousResearch/hermes-agent",
      "recipes": {
        "linux": {
          "channel": "project",
          "repository": "https://github.com/NousResearch/hermes-agent.git",
          "bin": "source/.venv/bin/hermes",
          "bin_dir": "source/.venv/bin",
          "env": {
            "UV_PYTHON_INSTALL_DIR": "{root}/python",
            "UV_CACHE_DIR": "{root}/cache/uv"
          },
          "steps": [
            {
              "args": [
                "uv",
                "sync",
                "--frozen",
                "--no-dev",
                "--python",
                "3.14"
              ],
              "cwd": "{dir}/source"
            }
          ]
        },
        "darwin": {
          "channel": "project",
          "repository": "https://github.com/NousResearch/hermes-agent.git",
          "bin": "source/.venv/bin/hermes",
          "bin_dir": "source/.venv/bin",
          "env": {
            "UV_PYTHON_INSTALL_DIR": "{root}/python",
            "UV_CACHE_DIR": "{root}/cache/uv"
          },
          "steps": [
            {
              "args": [
                "uv",
                "sync",
                "--frozen",
                "--no-dev",
                "--python",
                "3.14"
              ],
              "cwd": "{dir}/source"
            }
          ]
        },
        "windows": {
          "channel": "project",
          "repository": "https://github.com/NousResearch/hermes-agent.git",
          "bin": "source/.venv/Scripts/hermes.exe",
          "bin_dir": "source/.venv/Scripts",
          "env": {
            "UV_PYTHON_INSTALL_DIR": "{root}/python",
            "UV_CACHE_DIR": "{root}/cache/uv"
          },
          "steps": [
            {
              "args": [
                "uv",
                "sync",
                "--frozen",
                "--no-dev",
                "--python",
                "3.14"
              ],
              "cwd": "{dir}/source"
            }
          ]
        }
      }
    },
    {
      "id": "agy",
      "binary": "agy",
      "source": "https://antigravity.google/download",
      "recipes": {
        "linux": {
          "channel": "update-manifest",
          "update_url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_{arch}.json",
          "archive_binary": "antigravity",
          "bin": "bin/agy",
          "bin_dir": "bin",
          "env": {
            "HOME": "{dir}/home",
            "USERPROFILE": "{dir}/home",
            "LOCALAPPDATA": "{dir}/home/local"
          }
        },
        "darwin": {
          "channel": "update-manifest",
          "update_url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/darwin_{arch}.json",
